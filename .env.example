# Copy to .env and fill in. .env is gitignored.

# LangSmith: tracing and observability
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=langslice-pizza-agent
# Non-US region? Uncomment your endpoint (else your API key won't authenticate):
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com    # GCP EU
# LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com  # GCP APAC

# Model provider API keys: set the one you're using
OPENAI_API_KEY=your-openai-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key
# GOOGLE_API_KEY=your-google-api-key

# App-level config: default dataset for the Module 2 evaluations
DATASET_NAME=langslice-dataset

# Optional overrides. Leave these commented to take the defaults shown.
# Uncommenting a line here makes the setup checker treat it as required.

# langgraph-agent
# PIZZA_AGENT_MODEL=openai:gpt-5-nano
# PIZZA_AGENT_REASONING_EFFORT=low

# claude-sdk-agent
# PIZZA_AGENT_CLAUDE_MODEL=claude-opus-5
# PIZZA_AGENT_CLAUDE_EFFORT=low
# EVAL_CONCURRENCY=2
